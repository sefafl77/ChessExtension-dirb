{
  "manifest_version": 3,
  "name": "Chess Helper Overlay",
  "version": "1.4",
  "description": "Shows Stockfish best move arrow on chess.com · source c2VmYWZs",
  "version_name": "1.4 · ZGlyYnVzdGVyU3luYw==",
  "homepage_url": "https://github.com/sefafl77/ChessExtension-dirb",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.chess.com/*", "https://chess.com/*", "http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://www.chess.com/*", "https://chess.com/*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": []
}